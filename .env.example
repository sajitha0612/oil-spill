PROXIMITY_WEIGHT=0.40
TRAJECTORY_WEIGHT=0.35
ANOMALY_WEIGHT=0.25
PROXIMITY_MAX_DISTANCE_KM=30.0
ANOMALY_GAP_THRESHOLD_MINUTES=60.0
