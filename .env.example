# Copy to .env to override. Full list of tunables in app/config.py.

PORT=8000
DEMO_MODE=true

SAR_DATA_DIR=./data/sar-images
WIND_SPEED_VALID_MIN_MS=1.5
WIND_SPEED_VALID_MAX_MS=10.0

OCEAN_CURRENT_DATA_DIR=./data/ocean-currents
DRIFT_DURATION_HOURS=144
