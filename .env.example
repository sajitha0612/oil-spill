# Copy to .env.local to override.

# Base URL of the backend API (Node orchestration layer).
VITE_API_BASE_URL=http://localhost:5000/api

# When true (default), all API calls in src/api/incidents.js resolve against
# the JSON files in /mock-data instead of hitting the network. Set to false
# once the real backend is up.
VITE_USE_MOCK=true
